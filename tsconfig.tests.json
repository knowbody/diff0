{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["test/**/*.test.ts", "test/helpers/**/*.ts", "scripts/*.ts"],
  "exclude": ["node_modules", "dist", "test/fixtures"]
}
