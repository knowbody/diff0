{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "agent/**/*.ts",
      "evals/**/*.ts",
      "test/**/*.ts",
      "test/**/*.mjs",
      "scripts/**/*.ts",
      "scripts/**/*.mjs",
      "action/**/*.mjs",
      "website/**/*.ts",
      "website/**/*.tsx",
      "website/**/*.mjs",
      "!**/dist",
      "!**/node_modules",
      "!website/.next",
      "!website/out",
      "!website/next-env.d.ts",
      "!test/fixtures",
      "!fixtures"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  }
}
