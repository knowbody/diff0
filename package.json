{
  "name": "@knowbody/diff0",
  "version": "0.1.3",
  "description": "CLI for behavioral diffs of Eve agents: run an eval suite against two git refs and compare what the agent did.",
  "keywords": [
    "eve",
    "vercel",
    "agents",
    "evals",
    "regression",
    "drift",
    "ci"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Mateusz Zatorski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowbody/diff0.git"
  },
  "homepage": "https://diff0.io",
  "bugs": "https://github.com/knowbody/diff0/issues",
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.18": "3.3.18"
    }
  },
  "files": [
    "dist",
    "prices.json",
    "README.md",
    "docs/library-api.md",
    "LICENSE",
    "action"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@github-tools/eve-extension": "^0.3.2",
    "@github-tools/sdk": "1.11.1",
    "@types/node": "^26.1.2",
    "@vercel/blob": "^2.8.0",
    "@vercel/connect": "0.8.0",
    "ai": "7.0.85",
    "esbuild": "0.28.1",
    "eve": "0.47.5",
    "just-bash": "^3.4.2",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "4.4.3"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "markdown-table": "^3.0.4",
    "minimatch": "^10.2.6",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.0"
  },
  "bin": {
    "diff0": "dist/cli.js"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./runner": { "types": "./dist/runner.d.ts", "import": "./dist/runner.js" },
    "./reporters": { "types": "./dist/reporters.d.ts", "import": "./dist/reporters.js" },
    "./eve": { "types": "./dist/eve.d.ts", "import": "./dist/eve.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "action:build": "node scripts/build-action.mjs",
    "typecheck": "tsc --noEmit && pnpm agent:typecheck",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --exclude '**/*.package.test.ts'",
    "test:package": "pnpm build && vitest run test/library.package.test.ts",
    "test:integration": "vitest run integration.test.ts",
    "agent:build": "eve build",
    "agent:check": "biome check agent evals test/agent-security.test.ts test/agent-publishing.test.ts test/agent-runtime.test.ts",
    "agent:dev": "eve dev",
    "agent:diff": "pnpm build && FACTORY_EVAL_SANDBOX=justbash node dist/cli.js run --repo . --app-dir . --evals smoke,routing/needs-clarification,safety/prompt-injection,safety/write-requires-approval --runs 3 --max-spend 3",
    "agent:eval": "eve eval",
    "agent:info": "eve info",
    "agent:start": "eve start",
    "agent:test": "vitest run test/agent-security.test.ts test/agent-publishing.test.ts test/agent-runtime.test.ts",
    "agent:test:runtime": "node scripts/check-station-retries.mjs",
    "agent:typecheck": "tsc -p agent/tsconfig.json",
    "agent:validate": "pnpm agent:check && pnpm agent:typecheck && pnpm agent:test && pnpm agent:info",
    "lint": "biome check .",
    "format": "biome format --write .",
    "refresh-prices": "node scripts/refresh-prices.mjs",
    "prepublishOnly": "pnpm build && pnpm action:build"
  }
}
