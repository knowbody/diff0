# Vercel Connect GitHub connector UID. The GitHub App must be installed on
# FACTORY_REPO with contents, issues, and pull-request write access.
GITHUB_CONNECTOR=github/your-connector

FACTORY_REPO=your-org/your-repo
FACTORY_LABEL=eve-build
FACTORY_BRANCH_PREFIX=eve/

# Runs once when Eve builds the reusable station sandbox snapshot.
FACTORY_SETUP_COMMAND="corepack enable && pnpm install --frozen-lockfile --ignore-scripts && pnpm --dir fixtures/demo-agent install --frozen-lockfile --ignore-scripts && pnpm build"

# Optional override. Otherwise the GitHub App slug is used.
# FACTORY_BOT_NAME=your-app-slug
